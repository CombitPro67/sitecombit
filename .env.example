# Endpoint формы из панели Formspree, например:
# PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
PUBLIC_FORMSPREE_ENDPOINT=

# Основной домен на GitHub Pages. Такое же значение используется на Layero.
SITE_URL=https://kombit.ru/
# На kombit.ru и резервном Layero файлы доступны от корня домена.
# Для предпросмотра на combitpro67.github.io/sitecombit/ укажите /sitecombit/.
# В GitHub Actions префикс определяется настройками Pages автоматически.
SITE_BASE_PATH=/
